# ==========================================
# ⚡ CardNews Studio 환경변수 설정 가이드
# ==========================================

# 1. OpenAI API 키 (필수)
# - 릴스 오디오 Whisper-1 STT 음성 전사
# - 카드뉴스 이미지 GPT-4o-mini Vision 분석
# - 7대 떡상 관점 및 슬라이드별 대본 생성
OPENAI_API_KEY=your_openai_api_key_here

# 2. Apify API 토큰 (필수)
# - 인스타그램 주제별 릴스/게시물 20개 실시간 수집
# - 특정 타겟 계정 최신 릴스 전수 크롤링
# - 단일 릴스/게시물 URL 정밀 스크래핑
APIFY_TOKEN=your_apify_api_token_here

# 3. 로컬 Express 대시보드 서버 포트 (기본값: 3000)
PORT=3000

# 4. 인스타그램 캐러셀 자동 업로드 (선택 · 대시보드 5번 탭 "인스타그램에 올리기")
# - 인스타 비즈니스/크리에이터 계정 + instagram_content_publish 권한 토큰 필요
# - 토큰이 EAA... 면 graph.facebook.com, IGAA... 면 graph.instagram.com 을 자동 사용
IG_USER_ID=your_instagram_business_account_id
IG_ACCESS_TOKEN=your_long_lived_access_token

# - 인스타가 내려받을 공개 이미지 주소 확보 (둘 중 하나, Cloudinary 우선)
# [추천] Cloudinary 무료 계정: 대시보드 > API Keys 의 "API environment variable" 값을 그대로 복사
#        카드를 임시 업로드 → 게시 → 자동 삭제. 대시보드는 인터넷에 공개되지 않음.
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
# [대안] 이 서버의 공개 주소 (localhost 불가, 켜져 있는 동안 대시보드 전체가 공개됨)
#        예: npx cloudflared tunnel --url http://localhost:3000  →  https://xxxx.trycloudflare.com
# PUBLIC_BASE_URL=https://your-public-url.example.com
